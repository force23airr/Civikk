{
  "name": "@civik/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "ios": "expo start --ios",
    "preview:android": "eas build --platform android --profile preview",
    "preview:ios": "eas build --platform ios --profile preview",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@civik/types": "file:../../packages/types",
    "expo": "^53.0.0",
    "expo-location": "~18.1.0",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.2"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "^5.8.0"
  }
}
