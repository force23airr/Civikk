{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "latest" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "latest" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.civik.local"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": { "image": "latest" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.civik.com"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
